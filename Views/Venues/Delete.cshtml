@model EventEase.Models.Venues

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div>
    <h4>Venues</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.VenueLocation</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.VenueName</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.VenueImageURL))
            {
                <img src="@Model.VenueImageURL" height="120" width="180" />
            }
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="VenueId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        |
        <a asp-action="Index" class="btn btn-primary">Back to List</a>
    </form>
</div>