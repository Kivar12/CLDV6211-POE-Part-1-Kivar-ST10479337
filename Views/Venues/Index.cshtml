@model IEnumerable<EventEase.Models.Venues>

@{
    ViewData["Title"] = "Index";
}

<h1>Venues</h1>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <p>
         <a asp-action="Create" class="btn btn-primary">Create Venue</a>
            </p>

            <table class="table">
                <thead>
                    <tr>
                        <th>Venue Location</th>
                        <th>Venue Name</th>
                        <th>Capacity</th>
                        <th>Image</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.VenueLocation</td>
                            <td>@item.VenueName</td>
                            <td>@item.Capacity</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.VenueImageURL))
                    {
                        <img src="@item.VenueImageURL" height="120" width="180" />
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.VenueId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.VenueId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.VenueId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>