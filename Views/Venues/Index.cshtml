@model IEnumerable<EventEase.Models.Venues>

@{
    ViewData["Title"] = "Index";
}

<h1>Venues</h1>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <p>
         <a asp-action="Create" class="btn btn-primary">Create Venue</a>
            </p>
<form method="get">

    <label>Venue Availability</label>

    <select name="venueAvailable" class="form-control mb-3" style="width:300px;">
        <option value="" selected="@(ViewBag.VenueAvailable == null)">
            All Venues
        </option>

        <option value="true" selected="@(ViewBag.VenueAvailable?.ToString() == "True")">
            Available Venues
        </option>

        <option value="false" selected="@(ViewBag.VenueAvailable?.ToString() == "False")">
            Fully Booked
        </option>
    </select>

    <button type="submit" class="btn btn-primary">Filter results</button>

    <br />
   
    <br />

    <a asp-action="Index" class="btn btn-primary">Clear</a>

</form>

<br />
            <table class="table">
                <thead>
                    <tr>
                        <th>Venue Location</th>
                        <th style="width: 400px;">Venue Name</th>
                        <th>Capacity</th>
                        <th style="width: 250px;">Image</th>
                        <th style ="width: 250px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.VenueLocation</td>
                            <td>@item.VenueName</td>
                            <td>@item.Capacity</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.VenueImageURL))
                    {
                        <div class="text-center">
                        <img src="@item.VenueImageURL" height="140" width="240" />
                        </div>
                    }
                </td>

                <td>
                    <a asp-action="Edit" class="btn btn-primary" asp-route-id="@item.VenueId">Edit</a> |
                    <a asp-action="Details" class="btn btn-primary" asp-route-id="@item.VenueId">Details</a> |
                    <a asp-action="Delete" class="btn btn-primary" asp-route-id="@item.VenueId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>