@model IEnumerable<EventEase.Models.Events>

@{
    ViewData["Title"] = "Index";
}

<h1>Events</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create Event</a>
</p>

<form method="get" class="mb-4">

    <label>Search</label>
    <input type="text"
           name="searchString"
           value="@ViewBag.SearchString"
           placeholder="Search by Event Name or Event Location"
           class="form-control mb-2" 
           style="width: 600px;" />

    <label>Event Type</label>
    <input type="text"
           name="eventType"
           value="@ViewBag.EventType"
           placeholder="Search by Event Type"
           class="form-control mb-2" 
           style="width: 600px;" />

    <label>Start Date</label>
    <input type="date"
           name="startDate"
           value="@ViewBag.StartDate"
           class="form-control mb-2" 
           style="width: 600px;" />

    <label>End Date</label>
    <input type="date"
           name="endDate"
           value="@ViewBag.EndDate"
           class="form-control mb-3" 
           style="width: 600px;" />

    <button type="submit" class="btn btn-primary">
        Filter results
    </button>
    
    <br />

    <br />

    <a asp-action="Index" class="btn btn-primary">
        Clear
    </a>

</form>

<table class="table">
    <thead>
        <tr>
            <th style="width: 180px;">Event Name</th>
            <th>Event Location</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th style="width: 250px;">Image</th>
            <th style="width: 250px;">Actions</th>
        </tr>
    </thead>

    <tbody>
         @if (Model != null && Model.Any())
        {
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.EventLocation</td>
                <td>@item.Startdate</td>
                <td>@item.Enddate</td>
                <td>
                    <div class="text-center">
                    <img src="@item.EventImageURL" height="140" width="240" />
                    </div>
                </td>
                <td>
                    <a asp-action="Edit" class="btn btn-primary" asp-route-id="@item.EventId">Edit</a> |
                    <a asp-action="Details" class="btn btn-primary" asp-route-id="@item.EventId">Details</a> |
                    <a asp-action="Delete" class="btn btn-primary" asp-route-id="@item.EventId">Delete</a>
                </td>
            </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No records found
                </td>
            </tr>
        }
    </tbody>
</table>