@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1><b>Welcome to EventEase</b></h1>
    <p><b>Where you can book all your bookings, events and venues</b></p>
    
    <div style="margin-top: 30px;">

        <a asp-controller="Home" asp-action="Privacy" class="btn btn-dark m-2">
            Privacy Policy
        </a>

        <a asp-controller="Bookings" asp-action="Index" class="btn btn-success m-2">
            Bookings
        </a>

        <a asp-controller="Venues" asp-action="Index" class="btn btn-primary m-2">
            Venues
        </a>

        <a asp-controller="Events" asp-action="Index" class="btn btn-danger m-2">
            Events
        </a>

        <a asp-controller="EventHistory" asp-action="Index" class="btn btn-purple m-2">
            Event History
        </a>
        
    </div>
</div>

<div class="text-center mt-5">
    <h1><b>Total Bookings, Venues and Events</b></h1>
</div>

<div class="d-flex justify-content-center mt-4">

    <div class="d-flex gap-4 text-center">


        <div style="width:200px; padding:20px; border-radius:12px; background:green; color:white;">
            <h4>Bookings</h4>
            <h2>@ViewBag.TotalBookings</h2>
        </div>

        <div style="width:200px; padding:20px; border-radius:12px; background:darkblue; color:white;">
            <h4>Venues</h4>
            <h2>@ViewBag.TotalVenues</h2>
        </div>

        <div style="width:200px; padding:20px; border-radius:12px; background:red; color:white;">
            <h4>Events</h4>
            <h2>@ViewBag.TotalEvents</h2>
        </div>

    </div>

</div>